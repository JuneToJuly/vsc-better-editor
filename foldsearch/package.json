{
  "name": "foldsearch",
  "displayName": "FoldSearch",
  "version": "0.0.8",
  "publisher": "ian.thomas",
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onCommand:foldsearch.search",
    "onCommand:foldsearch.toggle",
    "onCommand:foldsearch.toggleScope",
    "onCommand:foldsearch.down",
    "onCommand:foldsearch.up",
    "onCommand:foldsearch.accessor",
    "onCommand:foldsearch.mutator",
    "onCommand:foldsearch.word",
    "onCommand:foldsearch.last"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "foldsearch.search",
        "title": "FoldSearch: Search"
      },
      {
        "command": "foldsearch.last",
        "title": "FoldSearch: Last"
      },
      {
        "command": "foldsearch.accessor",
        "title": "FoldSearch: Accessor"
      },
      {
        "command": "foldsearch.mutator",
        "title": "FoldSearch: Mutator"
      },
      {
        "command": "foldsearch.toggle",
        "title": "FoldSearch: Toggle Folds"
      },
      {
        "command": "foldsearch.toggleScope",
        "title": "FoldSearch: Toggle Method-Only Search"
      },
      {
        "command": "foldsearch.word",
        "title": "FoldSearch: Word at Cursor"
      },
      {
        "command": "foldsearch.down",
        "title": "FoldSearch: Move Down (Visible)"
      },
      {
        "command": "foldsearch.up",
        "title": "FoldSearch: Move Up (Visible)"
      }
    ]
  }
}
