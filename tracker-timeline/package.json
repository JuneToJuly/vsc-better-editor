{
  "name": "tracker-timeline",
  "displayName": "Tracker Timeline",
  "description": "Walk through your development one save at a time using private Git timeline commits.",
  "version": "0.5.9",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:trackerTimeline"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tracker",
          "title": "Tracker",
          "icon": "media/timeline.svg"
        }
      ]
    },
    "views": {
      "tracker": [
        {
          "id": "trackerTimeline",
          "name": "Development Timeline"
        }
      ]
    },
    "commands": [
      {
        "command": "trackerTimeline.refresh",
        "title": "Tracker: Refresh Timeline",
        "icon": "$(refresh)"
      },
      {
        "command": "trackerTimeline.openViewer",
        "title": "Tracker: Open Change Viewer",
        "icon": "$(preview)"
      },
      {
        "command": "trackerTimeline.openDiff",
        "title": "Tracker: Open Save Diff"
      },
      {
        "command": "trackerTimeline.previousDiff",
        "title": "Previous Diff",
        "icon": "$(arrow-left)"
      },
      {
        "command": "trackerTimeline.nextDiff",
        "title": "Next Diff",
        "icon": "$(arrow-right)"
      },
      {
        "command": "trackerTimeline.pause",
        "title": "Tracker: Pause Recording"
      },
      {
        "command": "trackerTimeline.resume",
        "title": "Tracker: Resume Recording"
      },
      {
        "command": "trackerTimeline.openCurrent",
        "title": "Tracker: Open Current Branch Timeline"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "trackerTimeline.refresh",
          "when": "view == trackerTimeline",
          "group": "navigation"
        },
        {
          "command": "trackerTimeline.openViewer",
          "when": "view == trackerTimeline",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "trackerTimeline.openViewer",
          "when": "view == trackerTimeline && (viewItem == trackerSave || viewItem == trackerSaveActive)",
          "group": "inline@1"
        },
        {
          "command": "trackerTimeline.openDiff",
          "when": "view == trackerTimeline && (viewItem == trackerSave || viewItem == trackerSaveActive)",
          "group": "inline@2"
        }
      ],
      "editor/title": [
        {
          "command": "trackerTimeline.previousDiff",
          "when": "trackerTimeline.replayDiffActive && trackerTimeline.canPreviousDiff",
          "group": "navigation@1"
        },
        {
          "command": "trackerTimeline.nextDiff",
          "when": "trackerTimeline.replayDiffActive && trackerTimeline.canNextDiff",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Tracker Timeline",
      "properties": {
        "trackerTimeline.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Record a private Git timeline commit whenever a file is saved."
        },
        "trackerTimeline.includeUntracked": {
          "type": "boolean",
          "default": true,
          "description": "Include non-ignored untracked files in each repository snapshot."
        },
        "trackerTimeline.maxVisibleEntries": {
          "type": "number",
          "default": 250,
          "minimum": 10,
          "maximum": 5000,
          "description": "Maximum saves shown in the timeline view."
        }
      }
    }
  },
  "scripts": {
    "package": "npx @vscode/vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0"
  }
}
