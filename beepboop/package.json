{
  "name": "ambient-action-audio",
  "displayName": "Ambient Action Audio",
  "description": "Selectable ambient sound environments with reliable immediate Vim feedback and controlled voice replacement.",
  "version": "1.1.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ambientActionAudio.toggle",
        "title": "Ambient Action Audio: Toggle Sounds"
      },
      {
        "command": "ambientActionAudio.preview",
        "title": "Ambient Action Audio: Preview Sound Pack"
      },
      {
        "command": "ambientActionAudio.playSuccess",
        "title": "Ambient Action Audio: Play Success Sound"
      },
      {
        "command": "ambientActionAudio.playFailure",
        "title": "Ambient Action Audio: Play Failure Sound"
      },
      {
        "command": "ambientActionAudio.vimNormal",
        "title": "Ambient Action Audio: Vim Normal Mode"
      },
      {
        "command": "ambientActionAudio.vimInsert",
        "title": "Ambient Action Audio: Vim Insert Mode"
      },
      {
