    "configuration": {
      "title": "Ambient Action Audio",
      "properties": {
        "ambientActionAudio.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable all action sounds."
        },
        "ambientActionAudio.volume": {
          "type": "number",
          "default": 0.18,
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Playback volume. Native WAV playback support varies by operating system; on Windows this setting is approximated when generating tones."
        },
        "ambientActionAudio.minimumIntervalMs": {
          "type": "number",
          "default": 180,
          "minimum": 0,
          "maximum": 5000,
          "description": "Minimum delay between repeated instances of the same sound."
        },
        "ambientActionAudio.muteWhenWindowInactive": {
          "type": "boolean",
          "default": true,
          "description": "Do not play sounds when the VS Code window is inactive."
        },
        "ambientActionAudio.save": {
          "type": "boolean",
          "default": true,
          "description": "Play a sound after saving a file."
        },
        "ambientActionAudio.openClose": {
          "type": "boolean",
          "default": true,
          "description": "Play sounds when text documents are opened or closed."
        },
        "ambientActionAudio.editorNavigation": {
          "type": "boolean",
          "default": false,
          "description": "Play a quiet sound when switching active editors."
        },
        "ambientActionAudio.tasks": {
          "type": "boolean",
          "default": true,
          "description": "Play sounds when tasks start and finish."
        },
        "ambientActionAudio.debug": {
          "type": "boolean",
          "default": true,
          "description": "Play sounds when debug sessions start and stop."
        },
        "ambientActionAudio.vim.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable commands used by VSCodeVim remappings."
        },
        "ambientActionAudio.vim.actionCommands": {
          "type": "boolean",
          "default": true,
          "description": "Enable commands that can be used in VSCodeVim remappings for yank, paste, delete, and search sounds."
        },
        "ambientActionAudio.vim.movement": {
          "type": "boolean",
          "default": true,
          "description": "Play directional cues for h, j, k, and l movement in Normal and Visual modes."
        },
        "ambientActionAudio.vim.pageMovement": {
          "type": "boolean",
          "default": true,
          "description": "Play cues for Page Up and Page Down."
        },
        "ambientActionAudio.vim.movementMinimumIntervalMs": {
          "type": "number",
          "default": 24,
          "minimum": 0,
          "maximum": 1000,
          "description": "Minimum interval between repeated Vim navigation sounds. The default is low enough to preserve feedback during rapid movement."
        },
        "ambientActionAudio.soundVariation": {
          "type": "boolean",
          "default": true,
          "description": "Choose among subtly varied natural samples so repeated navigation feels organic."
        },
        "ambientActionAudio.vim.autoInstallNavigationMappings": {
          "type": "boolean",
          "default": true,
          "description": "Automatically install VSCodeVim remappings for Ctrl+U and Ctrl+D. This avoids keybinding precedence conflicts with VSCodeVim."
        },
        "ambientActionAudio.globalMinimumIntervalMs": {
          "type": "number",
          "default": 12,
          "minimum": 0,
          "maximum": 1000,
          "description": "Tiny duplicate-event guard. New sounds are no longer discarded merely because another sound is playing."
        },
        "ambientActionAudio.maxConcurrentSounds": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 8,
          "description": "Maximum simultaneous player processes. When full, the oldest sound is stopped so the newest action still receives immediate feedback."
        },
        "ambientActionAudio.vim.autoInstallActionMappings": {
          "type": "boolean",
          "default": true,
          "description": "Automatically install VSCodeVim mappings for Ctrl+U, Ctrl+D, c, d, y, and p."
        },
        "ambientActionAudio.environment": {
          "type": "string",
          "enum": [
            "voxel",
            "kingdomHearts",
            "zen"
          ],
          "enumDescriptions": [
            "Warm wooden tones, soft footsteps, airy page movement, and cave-like ambience.",
            "Original crystal, glass, choir-like, and magical tones inspired by airy fantasy soundscapes.",
            "Very restrained wood, breath, water, and singing-bowl-like tones."
          ],
          "default": "voxel",
          "description": "Select the active sound environment."
        },
        "ambientActionAudio.vim.actionMinimumIntervalMs": {
          "type": "number",
          "default": 18,
          "minimum": 0,
          "maximum": 500,
          "description": "Minimum interval between Vim operator sounds such as change, delete, yank, and put."
        }
      }
    },
    "keybindings": [
      {
        "key": "i",
        "command": "ambientActionAudio.vimTransition",
