          "sound": "vimWordForward",
          "after": [
            "w"
          ]
        }
      },
      {
        "key": "b",
        "command": "ambientActionAudio.vimTransition",
        "when": "editorTextFocus && vim.mode == 'VisualBlock'",
        "args": {
          "sound": "vimWordBackward",
          "after": [
            "b"
          ]
        }
      }
    ]
  },
