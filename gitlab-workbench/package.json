{
  "name": "gitlab-developer-workbench",
  "displayName": "GitLab Developer Workbench",
  "description": "A developer-first GitLab interface for VS Code powered by glab, with a built-in demo backend for testing.",
  "version": "0.16.50",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "activationEvents": [
    "onView:gitlabWorkbench.mergeRequests",
    "onCommand:gitlabWorkbench.openDashboard",
    "onView:gitlabWorkbench.issues",
    "onCommand:gitlabWorkbench.newIssue",
    "onCommand:gitlabWorkbench.issueFilter",
    "onCommand:gitlabWorkbench.issueSearch"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitlabWorkbench.openDashboard",
        "title": "GitLab Workbench: Open Dashboard"
      },
      {
        "command": "gitlabWorkbench.refresh",
        "title": "GitLab Workbench: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "gitlabWorkbench.manageProjects",
        "title": "GitLab Workbench: Manage Projects",
        "icon": "$(repo)"
      },
      {
        "command": "gitlabWorkbench.removeProject",
        "title": "GitLab Workbench: Remove Project",
        "icon": "$(trash)"
      },
      {
        "command": "gitlabWorkbench.addProject",
        "title": "GitLab Workbench: Add Project",
        "icon": "$(add)"
      },
      {
        "command": "gitlabWorkbench.showOutput",
        "title": "GitLab Workbench: Show Output"
      },
      {
        "command": "gitlabWorkbench.toggleDemo",
        "title": "GitLab Workbench: Toggle Demo Mode"
      },
      {
        "command": "gitlabWorkbench.openMr",
        "title": "GitLab Workbench: Open Merge Request"
      },
      {
        "command": "gitlabWorkbench.checkoutMr",
        "title": "GitLab Workbench: Checkout Merge Request"
      },
      {
        "command": "gitlabWorkbench.approveMr",
        "title": "GitLab Workbench: Approve Merge Request"
      },
      {
        "command": "gitlabWorkbench.mergeMr",
        "title": "GitLab Workbench: Merge Merge Request"
      },
      {
        "command": "gitlabWorkbench.openDiff",
        "title": "GitLab Workbench: Open File Diff"
      },
      {
        "command": "gitlabWorkbench.demoScenario",
        "title": "GitLab Workbench: Choose Demo Scenario"
      },
      {
        "command": "gitlabWorkbench.reviewMr",
        "title": "GitLab Workbench: Start Review"
      },
      {
        "command": "gitlabWorkbench.nextChange",
        "title": "GitLab Workbench: Next Changed File",
        "icon": "$(arrow-down)"
      },
      {
        "command": "gitlabWorkbench.previousChange",
        "title": "GitLab Workbench: Previous Changed File",
        "icon": "$(arrow-up)"
      },
      {
        "command": "gitlabWorkbench.markReviewed",
        "title": "GitLab Workbench: Mark Current File Reviewed",
        "icon": "$(check)"
      },
      {
        "command": "gitlabWorkbench.openReviewFile",
        "title": "GitLab Workbench: Open Review File"
      },
      {
        "command": "gitlabWorkbench.toggleReviewed",
        "title": "GitLab Workbench: Toggle File Reviewed"
      },
      {
        "command": "gitlabWorkbench.addReviewComment",
        "title": "GitLab Workbench: Add Review Comment",
        "icon": "$(comment-add)"
      },
      {
        "command": "gitlabWorkbench.finishReview",
        "title": "GitLab Workbench: Finish Review",
        "icon": "$(close)"
      },
      {
        "command": "gitlabWorkbench.nextUnresolved",
        "title": "GitLab Workbench: Next Unresolved Comment",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "gitlabWorkbench.replyDiscussion",
        "title": "GitLab Workbench: Reply to Review Comment",
        "icon": "$(reply)"
      },
      {
        "command": "gitlabWorkbench.resolveDiscussion",
        "title": "GitLab Workbench: Resolve Review Comment",
        "icon": "$(check-all)"
      },
      {
        "command": "gitlabWorkbench.openIssue",
        "title": "GitLab Workbench: Open Issue"
      },
      {
        "command": "gitlabWorkbench.newIssue",
        "title": "GitLab Workbench: New Issue",
        "icon": "$(new-file)"
      },
      {
        "command": "gitlabWorkbench.issueSearch",
        "title": "GitLab Workbench: Search Issues",
        "icon": "$(search)"
      },
      {
        "command": "gitlabWorkbench.issueFilter",
        "title": "GitLab Workbench: Filter Issues",
        "icon": "$(filter)"
      },
      {
        "command": "gitlabWorkbench.manageTrackedAssignees",
        "title": "GitLab Workbench: Manage Tracked Assignees",
        "icon": "$(person-add)"
      },
      {
        "command": "gitlabWorkbench.issueViewMode",
        "title": "GitLab Workbench: Change Issue View",
        "icon": "$(layout)"
      },
      {
        "command": "gitlabWorkbench.prepareJavaReview",
        "title": "GitLab Workbench: Prepare Java Review Root",
        "icon": "$(coffee)"
      },
      {
        "command": "gitlabWorkbench.switchJavaReviewRoot",
        "title": "GitLab Workbench: Switch Fast Composite JDT Root",
        "icon": "$(sync)"
      },
      {
        "command": "gitlabWorkbench.toggleUnassigned",
        "title": "GitLab Workbench: Toggle Unassigned",
        "icon": "$(person)"
      },
      {
        "command": "gitlabWorkbench.cloneManagedProjects",
        "title": "GitLab Workbench: Clone Managed Projects",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitlabWorkbench.submitReview",
        "title": "GitLab Workbench: Submit Review",
        "icon": "$(send)"
      },
      {
        "command": "gitlabWorkbench.discardReview",
        "title": "GitLab Workbench: Discard Pending Review",
        "icon": "$(trash)"
      },
      {
        "command": "gitlabWorkbench.openPendingReviewComment",
        "title": "GitLab Workbench: Open Pending Review Comment"
      },
      {
        "command": "gitlabWorkbench.collapseReviewComments",
        "title": "GitLab Workbench: Collapse All Review Comments",
        "icon": "$(fold)"
      },
      {
        "command": "gitlabWorkbench.expandReviewComments",
        "title": "GitLab Workbench: Expand All Review Comments",
        "icon": "$(unfold)"
      },
      {
        "command": "gitlabWorkbench.toggleResolvedComments",
        "title": "GitLab Workbench: Hide/Show Resolved Comments",
        "icon": "$(eye-closed)"
      },
      {
        "command": "gitlabWorkbench.resolveSourceFeedback",
        "title": "GitLab Workbench: Resolve Feedback",
        "icon": "$(check)"
      },
      {
        "command": "gitlabWorkbench.refreshSourceFeedback",
        "title": "GitLab Workbench: Refresh Source Feedback",
        "icon": "$(refresh)"
      },
      {
        "command": "gitlabWorkbench.openSourceFeedbackById",
        "title": "GitLab Workbench: Open Source Feedback"
      },
      {
        "command": "gitlabWorkbench.resolveSourceFeedbackById",
        "title": "GitLab Workbench: Resolve Source Feedback"
      },
      {
        "command": "gitlabWorkbench.closeSourceFeedback",
        "title": "GitLab Workbench: Close Source Feedback"
      },
      {
        "command": "gitlabWorkbench.replySourceFeedbackById",
        "title": "GitLab Workbench: Reply to Source Feedback",
        "icon": "$(reply)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitlabWorkbench",
          "title": "GitLab Workbench",
          "icon": "resources/gitlab.svg"
        }
      ]
    },
    "views": {
      "gitlabWorkbench": [
        {
          "id": "gitlabWorkbench.mergeRequests",
          "name": "Merge Requests",
          "when": "!gitlabWorkbench.reviewActive",
          "type": "webview"
        },
        {
          "id": "gitlabWorkbench.issues",
          "name": "Issues",
          "when": "!gitlabWorkbench.reviewActive"
        },
        {
          "id": "gitlabWorkbench.reviewExplorer",
          "name": "Review Explorer",
          "when": "gitlabWorkbench.reviewActive",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "GitLab Developer Workbench",
      "properties": {
        "gitlabWorkbench.demoMode": {
          "type": "boolean",
          "default": true,
          "description": "Use a deterministic fake GitLab backend. No GitLab project is required."
        },
        "gitlabWorkbench.glabPath": {
          "type": "string",
          "default": "glab",
          "description": "Path to the glab executable."
        },
        "gitlabWorkbench.perPage": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 100,
          "description": "Merge requests fetched per repository."
        },
        "gitlabWorkbench.managedProjects": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "GitLab project URLs managed by the Workbench. Projects do not need to be cloned locally."
        },
        "gitlabWorkbench.discoverLocalRepositories": {
          "type": "boolean",
          "default": false,
          "description": "Also discover GitLab projects from Git repositories in the current VS Code workspace."
        },
        "gitlabWorkbench.trackedAssignees": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "GitLab usernames kept as quick filters in the Issues view."
        },
        "gitlabWorkbench.prepareCompositeRootOnStart": {
          "type": "boolean",
          "default": false,
          "description": "Automatically generate and add/switch a Fast Composite JDT review root when starting a live review. When disabled, Start Review only prepares the normal local review checkout."
        },
        "gitlabWorkbench.unifiedDiff": {
          "type": "boolean",
          "default": true,
          "description": "Show GitLab Workbench review diffs in a single unified/inline diff editor instead of side-by-side when possible."
        },
        "gitlabWorkbench.peopleBoard.showUnassigned": {
          "type": "boolean",
          "default": true,
          "description": "Show unassigned work on the People Board."
        },
        "gitlabWorkbench.peopleBoard.peopleConfigured": {
          "type": "boolean",
          "default": false,
          "description": "Whether the People Board tracked-person selection has been explicitly configured."
        }
      }
    },
    "keybindings": [
      {
        "command": "gitlabWorkbench.nextChange",
        "key": "f7",
        "when": "gitlabWorkbench.reviewActive"
      },
      {
        "command": "gitlabWorkbench.previousChange",
        "key": "shift+f7",
        "when": "gitlabWorkbench.reviewActive"
      },
      {
        "command": "gitlabWorkbench.addReviewComment",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "gitlabWorkbench.reviewActive && editorTextFocus"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitlabWorkbench.submitReview",
          "when": "view == gitlabWorkbench.reviewExplorer && gitlabWorkbench.reviewActive",
          "group": "navigation@0"
        },
        {
          "command": "gitlabWorkbench.prepareJavaReview",
          "when": "view == gitlabWorkbench.reviewExplorer && gitlabWorkbench.reviewActive",
          "group": "navigation@0.1"
        },
        {
          "command": "gitlabWorkbench.switchJavaReviewRoot",
          "when": "view == gitlabWorkbench.reviewExplorer && gitlabWorkbench.reviewActive",
          "group": "navigation@0.2"
        },
        {
          "command": "gitlabWorkbench.markReviewed",
          "when": "view == gitlabWorkbench.reviewExplorer && gitlabWorkbench.reviewActive",
          "group": "navigation@1"
        },
        {
          "command": "gitlabWorkbench.nextUnresolved",
          "when": "view == gitlabWorkbench.reviewExplorer && gitlabWorkbench.reviewActive",
          "group": "navigation@1.5"
        },
        {
          "command": "gitlabWorkbench.addReviewComment",
          "when": "view == gitlabWorkbench.reviewExplorer && gitlabWorkbench.reviewActive",
          "group": "navigation@2"
        },
        {
          "command": "gitlabWorkbench.previousChange",
          "when": "view == gitlabWorkbench.reviewExplorer && gitlabWorkbench.reviewActive",
          "group": "navigation@2"
        },
        {
          "command": "gitlabWorkbench.nextChange",
          "when": "view == gitlabWorkbench.reviewExplorer && gitlabWorkbench.reviewActive",
          "group": "navigation@3"
        },
        {
          "command": "gitlabWorkbench.finishReview",
          "when": "view == gitlabWorkbench.reviewExplorer && gitlabWorkbench.reviewActive",
          "group": "navigation@4"
        },
        {
          "command": "gitlabWorkbench.refresh",
          "when": "view == gitlabWorkbench.mergeRequests && !gitlabWorkbench.reviewActive",
          "group": "navigation@0"
        },
        {
          "command": "gitlabWorkbench.addProject",
          "when": "view == gitlabWorkbench.mergeRequests && !gitlabWorkbench.reviewActive",
          "group": "navigation@1"
        },
        {
          "command": "gitlabWorkbench.manageProjects",
          "when": "view == gitlabWorkbench.mergeRequests && !gitlabWorkbench.reviewActive",
          "group": "navigation@2"
        },
        {
          "command": "gitlabWorkbench.addProject",
          "when": "view == gitlabWorkbench.issues && !gitlabWorkbench.reviewActive",
          "group": "navigation@1"
        },
        {
          "command": "gitlabWorkbench.manageProjects",
          "when": "view == gitlabWorkbench.issues && !gitlabWorkbench.reviewActive",
          "group": "navigation@2"
        },
        {
          "command": "gitlabWorkbench.newIssue",
          "when": "view == gitlabWorkbench.issues && !gitlabWorkbench.reviewActive",
          "group": "navigation@0"
        },
        {
          "command": "gitlabWorkbench.issueFilter",
          "when": "view == gitlabWorkbench.issues && !gitlabWorkbench.reviewActive",
          "group": "navigation@0.6"
        },
        {
          "command": "gitlabWorkbench.issueViewMode",
          "when": "view == gitlabWorkbench.issues",
          "group": "navigation@3"
        },
        {
          "command": "gitlabWorkbench.issueSearch",
          "when": "view == gitlabWorkbench.issues && !gitlabWorkbench.reviewActive",
          "group": "navigation@0.5"
        },
        {
          "command": "gitlabWorkbench.manageTrackedAssignees",
          "when": "view == gitlabWorkbench.issues && !gitlabWorkbench.reviewActive",
          "group": "navigation@0.7"
        },
        {
          "command": "gitlabWorkbench.toggleUnassigned",
          "when": "view == gitlabWorkbench.issues && !gitlabWorkbench.reviewActive",
          "group": "navigation@0.8"
        },
        {
          "command": "gitlabWorkbench.cloneManagedProjects",
          "when": "view == gitlabWorkbench.mergeRequests && !gitlabWorkbench.reviewActive",
          "group": "navigation@2.5"
        },
        {
          "command": "gitlabWorkbench.discardReview",
          "when": "view == gitlabWorkbench.reviewExplorer && gitlabWorkbench.reviewActive",
          "group": "navigation@9"
        },
        {
          "command": "gitlabWorkbench.collapseReviewComments",
          "when": "view == gitlabWorkbench.reviewExplorer && gitlabWorkbench.reviewActive",
          "group": "navigation@1.6"
        },
        {
          "command": "gitlabWorkbench.expandReviewComments",
          "when": "view == gitlabWorkbench.reviewExplorer && gitlabWorkbench.reviewActive",
          "group": "navigation@1.7"
        },
        {
          "command": "gitlabWorkbench.toggleResolvedComments",
          "when": "view == gitlabWorkbench.reviewExplorer && gitlabWorkbench.reviewActive",
          "group": "navigation@1.8"
        }
      ],
      "view/item/context": [
        {
          "command": "gitlabWorkbench.toggleReviewed",
          "when": "view == gitlabWorkbench.reviewExplorer && viewItem == reviewFile",
          "group": "inline"
        },
        {
          "command": "gitlabWorkbench.toggleReviewed",
          "when": "view == gitlabWorkbench.reviewExplorer && viewItem == reviewFileReviewed",
          "group": "inline"
        },
        {
          "command": "gitlabWorkbench.replyDiscussion",
          "when": "view == gitlabWorkbench.reviewExplorer && viewItem == reviewDiscussion",
          "group": "inline@1"
        },
        {
          "command": "gitlabWorkbench.resolveDiscussion",
          "when": "view == gitlabWorkbench.reviewExplorer && viewItem == reviewDiscussion",
          "group": "inline@2"
        },
        {
          "command": "gitlabWorkbench.replyDiscussion",
          "when": "view == gitlabWorkbench.reviewExplorer && viewItem == reviewGeneralDiscussion",
          "group": "inline@1"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "gitlabWorkbench.resolveSourceFeedback",
          "when": "commentThread == gitlabSourceFeedback",
          "group": "inline@1"
        }
      ]
    }
  },
  "scripts": {
    "test": "node src/test/run.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.95.0"
  }
}