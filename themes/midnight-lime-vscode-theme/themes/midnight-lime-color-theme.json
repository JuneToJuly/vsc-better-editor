  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7E898E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Control flow \u2014 lime",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.return",
        "keyword.control.exception"
      ],
      "settings": {
        "foreground": "#DCF763",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Java and language declarations \u2014 warm sand",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.declaration",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#E7B36A"
      }
    },
    {
      "name": "Functions \u2014 silver lavender",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#C6B6D8"
      }
    },
    {
      "name": "Types and classes \u2014 lime ivory",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "support.type",
        "support.class",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#D7E98A"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "identifier",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#F1F2EE"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "meta.parameters"
      ],
      "settings": {
        "foreground": "#C9C2C2"
      }
    },
    {
      "name": "Properties and fields",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#D77BAE"
      }
    },
    {
      "name": "Strings \u2014 lime cream",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#C7E85A"
      }
    },
    {
      "name": "Numbers and constants \u2014 rose",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#E58AB8"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#A7B0B3"
      }
    },
    {
      "name": "Annotations \u2014 magenta",
      "scope": [
        "meta.annotation",
        "punctuation.definition.annotation",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#E26BB2"
      }
    },
    {
      "name": "Packages and namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.package",
        "support.type.namespace"
      ],
      "settings": {
        "foreground": "#BFB7B6"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#A13B74"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#BFB7B6",
    "type": "#D7E98A",
    "class": "#D7E98A",
    "enum": "#CBB68C",
    "interface": "#D7E98A",
    "struct": "#D7E98A",
    "typeParameter": "#C9C2C2",
    "parameter": "#C9C2C2",
    "variable": "#F1F2EE",
    "property": "#D77BAE",
    "enumMember": "#E58AB8",
    "event": "#E26BB2",
    "function": "#C6B6D8",
    "method": "#C6B6D8",
    "macro": "#E7B36A",
    "label": "#DCF763",
    "comment": {
      "foreground": "#7E898E",
      "italic": true
    },
    "string": "#C7E85A",
    "number": "#E58AB8",
    "regexp": "#A9D96C",
    "operator": "#A7B0B3",
    "decorator": "#E26BB2",
    "keyword": "#E7B36A",
    "variable.readonly": "#E58AB8",
    "property.readonly": "#E99DC4",
    "class.defaultLibrary": "#DEEBA0",
    "function.defaultLibrary": "#D6C6E5",
    "method.defaultLibrary": "#D6C6E5"
  }
}
