  },
  "tokenColors": [
    {
      "name": "Default source text",
      "scope": [
        "source",
        "text"
      ],
      "settings": {
        "foreground": "#263F49"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8299A1",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation annotations",
      "scope": [
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc",
        "variable.other.jsdoc"
      ],
      "settings": {
        "foreground": "#5F8794"
      }
    },
    {
      "name": "Language declarations",
      "scope": [
        "keyword.control.import",
        "keyword.control.package",
        "keyword.other.import",
        "keyword.other.package",
        "storage.type.class",
        "storage.type.interface",
        "storage.type.enum",
        "storage.type.annotation",
        "storage.type"
      ],
      "settings": {
        "foreground": "#126FA8"
      }
    },
    {
      "name": "Modifiers in purple",
      "scope": [
        "storage.modifier",
        "storage.modifier.java",
        "storage.modifier.ts",
        "storage.modifier.js",
        "keyword.other.modifier"
      ],
      "settings": {
        "foreground": "#7B61B5"
      }
    },
    {
      "name": "Control flow in purple",
      "scope": [
        "keyword.control.return",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.trycatch",
        "keyword.control.exception",
        "keyword.control.switch",
        "keyword.control.throw",
        "keyword.control.break",
        "keyword.control.continue"
      ],
      "settings": {
        "foreground": "#7B61B5"
      }
    },
    {
      "name": "Async language features",
      "scope": [
        "storage.modifier.async",
        "keyword.control.async",
        "keyword.control.await",
        "keyword.other.async"
      ],
      "settings": {
        "foreground": "#7B61B5"
      }
    },
    {
      "name": "Constructors",
      "scope": [
        "meta.function.constructor entity.name.function",
        "entity.name.function.constructor",
        "storage.type.constructor"
      ],
      "settings": {
        "foreground": "#7B61B5"
      }
    },
    {
      "name": "Annotations and decorators",
      "scope": [
        "meta.annotation",
        "meta.annotation.java",
        "storage.type.annotation",
        "entity.name.type.annotation",
        "punctuation.definition.annotation",
        "meta.decorator",
        "meta.decorator entity.name.function",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#7B61B5"
      }
    },
    {
      "name": "Java declarations",
      "scope": [
        "source.java keyword.other.package",
        "source.java keyword.other.import",
        "source.java storage.type"
      ],
      "settings": {
        "foreground": "#126FA8"
      }
    },
    {
      "name": "Java modifiers in purple",
      "scope": [
        "source.java storage.modifier",
        "source.java keyword.other.modifier"
      ],
      "settings": {
        "foreground": "#7B61B5"
      }
    },
    {
      "name": "Java flow in purple",
      "scope": [
        "source.java keyword.control.return",
        "source.java keyword.control.throw",
        "source.java keyword.control.conditional",
        "source.java keyword.control.loop",
        "source.java keyword.control.trycatch",
        "source.java keyword.control.switch"
      ],
      "settings": {
        "foreground": "#7B61B5"
      }
    },
    {
      "name": "Java annotations in purple",
      "scope": [
        "source.java meta.annotation",
        "source.java storage.type.annotation",
        "source.java entity.name.type.annotation",
        "source.java punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#7B61B5"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#8D5B25"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#8D643D"
      }
    },
    {
      "name": "Language constants",
      "scope": [
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#8F5E32"
      }
    },
    {
      "name": "Class and type declarations",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "entity.name.enum",
        "support.type",
        "support.class",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#008D8A"
      }
    },
    {
      "name": "Primitive and built-in types",
      "scope": [
        "support.type.primitive",
        "storage.type.primitive",
        "support.type.builtin",
        "entity.name.type.module"
      ],
      "settings": {
        "foreground": "#008D8A"
      }
    },
    {
      "name": "Function and method declarations",
      "scope": [
        "meta.function entity.name.function",
        "meta.method.declaration entity.name.function",
        "entity.name.function.method",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#9A6031"
      }
    },
    {
      "name": "Function calls",
      "scope": [
        "meta.function-call entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#008D8A"
      }
    },
    {
      "name": "Properties and object keys",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.variable.property",
        "entity.name.function.property"
      ],
      "settings": {
        "foreground": "#008E91"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable"
      ],
      "settings": {
        "foreground": "#294954"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#294954"
      }
    },
    {
      "name": "This and super",
      "scope": [
        "variable.language.this",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#126FA8"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#526A74"
      }
    },
    {
      "name": "Punctuation and braces",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#526A74"
      }
    },
    {
      "name": "Java class names",
      "scope": [
        "source.java entity.name.type.class",
        "source.java entity.name.type.interface",
        "source.java entity.name.type.enum",
        "source.java support.class"
      ],
      "settings": {
        "foreground": "#008D8A"
      }
    },
    {
      "name": "Java methods",
      "scope": [
        "source.java meta.method.declaration entity.name.function",
        "source.java entity.name.function"
      ],
      "settings": {
        "foreground": "#008D8A"
      }
    },
    {
      "name": "Java strings",
      "scope": [
        "source.java string.quoted.double",
        "source.java punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#8D5B25"
      }
    },
    {
      "name": "Java braces",
      "scope": [
        "source.java punctuation.section.block",
        "source.java punctuation.section.parens",
        "source.java punctuation.separator",
        "source.java punctuation.terminator"
      ],
      "settings": {
        "foreground": "#526A74"
      }
    },
    {
      "name": "TypeScript declarations",
      "scope": [
        "source.ts entity.name.function",
        "source.tsx entity.name.function",
        "source.js entity.name.function",
        "source.jsx entity.name.function"
      ],
      "settings": {
        "foreground": "#9A6031"
      }
    },
    {
      "name": "TypeScript return/await",
      "scope": [
        "source.ts keyword.control.return",
        "source.tsx keyword.control.return",
        "source.js keyword.control.return",
        "source.jsx keyword.control.return",
        "source.ts keyword.control.await",
        "source.tsx keyword.control.await"
      ],
      "settings": {
        "foreground": "#7B61B5"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#126FA8"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#008D8A"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#087D8E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#168BB5"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
