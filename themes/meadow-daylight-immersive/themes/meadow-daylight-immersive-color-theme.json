  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#748A79",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#6C6A2E",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#725482"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#2E7187"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#4B773C"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#A05843"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable.name",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#315A72"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#84566C",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#3E715E"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#5F8547"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8A6534"
      }
    },
    {
      "scope": [
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#8B762E",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#55736B"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "operator"
      ],
      "settings": {
        "foreground": "#526E75"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#A33D39",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#4D7954",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#355D50",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#6E677D",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#356E7D"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#5C6F8A",
    "type": "#725482",
    "class": {
      "foreground": "#725482",
      "bold": true
    },
    "enum": "#7A648C",
    "interface": "#5A718E",
    "struct": "#6F5C80",
    "typeParameter": "#8B6B55",
    "parameter": {
      "foreground": "#84566C",
      "italic": true
    },
    "variable": "#315A72",
    "property": "#3E715E",
    "enumMember": {
      "foreground": "#8B762E",
      "bold": true
    },
    "function": "#2E7187",
    "method": "#2E7187",
    "macro": "#77692D",
    "label": "#617C55",
    "comment": {
      "foreground": "#748A79",
      "italic": true
    },
    "string": "#4B773C",
    "number": "#A05843",
    "regexp": "#3D817D",
    "operator": "#526E75",
    "decorator": "#8A527C",
    "keyword": {
      "foreground": "#6C6A2E",
      "bold": true
    },
    "variable.readonly": "#726C35",
    "property.readonly": "#61794A",
    "method.declaration": {
      "foreground": "#27667A",
      "bold": true
    },
    "function.declaration": {
      "foreground": "#27667A",
      "bold": true
    },
    "class.declaration": {
      "foreground": "#684976",
      "bold": true
    }
  }
}
