        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#DCE7EC",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#C3B3CC",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#C6D59A"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "constant.other.reference.link"
      ],
      "settings": {
        "foreground": "#F8F8F8",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#A990B2",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#81B7A2"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#D27A8A"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#D9B989"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#8C3345"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#D7B4BE",
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": [
        "meta.annotation",
        "storage.type.annotation",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#D3A3B4"
      }
    },
    {
      "scope": [
        "source.json support.type.property-name",
        "source.json meta.structure.dictionary.json string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#F8F8F8"
      }
    },
    {
      "scope": [
        "source.css entity.other.attribute-name.class",
        "source.css entity.other.attribute-name.id",
        "source.scss entity.other.attribute-name.class"
      ],
      "settings": {
        "foreground": "#B6A0C1"
      }
    },
    {
      "scope": [
        "support.constant.property-value.css",
        "support.constant.font-name.css",
        "constant.other.color.rgb-value.hex.css"
      ],
      "settings": {
        "foreground": "#C6D59A"
      }
    },
    {
      "scope": [
        "meta.embedded",
        "source.groovy.embedded",
        "source.java.embedded"
      ],
      "settings": {
        "foreground": "#DCE7EC"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#AFC5D6",
