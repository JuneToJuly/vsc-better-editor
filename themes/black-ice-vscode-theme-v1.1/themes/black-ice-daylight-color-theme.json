  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#7C8790",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "foreground": "#6F6874",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#6B4F78",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.exception",
        "keyword.control.return"
      ],
      "settings": {
        "foreground": "#8A5066",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "keyword.other",
        "punctuation.separator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#2F6978"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "entity.name.struct",
        "entity.name.enum",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#244D58"
      }
    },
    {
      "scope": [
        "entity.name.type.type-parameter",
        "meta.type.parameters entity.name.type"
      ],
      "settings": {
        "foreground": "#705D7C",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#356278",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function.constructor",
        "support.function.construct"
      ],
      "settings": {
        "foreground": "#486775",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable.name",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#334A56"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameter variable",
        "entity.name.variable.parameter"
      ],
      "settings": {
        "foreground": "#6F587E",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#466979"
      }
    },
    {
      "scope": [
        "variable.language",
        "support.variable",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#8A5066"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#755C82"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float"
      ],
      "settings": {
        "foreground": "#6C5479"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#65782C"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#244D58",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.class.component",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#6B4F78"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#244D58"
      }
    },
    {
      "scope": [
        "punctuation.definition.tag",
        "punctuation.definition.string",
        "punctuation.section",
        "punctuation.definition.parameters"
      ],
      "settings": {
        "foreground": "#2F6978"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#244D58",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#334A56",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#705D7C",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#65782C"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "constant.other.reference.link"
      ],
      "settings": {
        "foreground": "#244D58",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#714D77",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#39745E"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#A43F55"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#8A5D16"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#17232C",
        "background": "#8C3345"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#8A5066",
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": [
        "meta.annotation",
        "storage.type.annotation",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#8A5066"
      }
    },
    {
      "scope": [
        "source.json support.type.property-name",
        "source.json meta.structure.dictionary.json string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#244D58"
      }
    },
    {
      "scope": [
        "source.css entity.other.attribute-name.class",
        "source.css entity.other.attribute-name.id",
        "source.scss entity.other.attribute-name.class"
      ],
      "settings": {
        "foreground": "#6B4F78"
      }
    },
    {
      "scope": [
        "support.constant.property-value.css",
        "support.constant.font-name.css",
        "constant.other.color.rgb-value.hex.css"
      ],
      "settings": {
        "foreground": "#65782C"
      }
    },
    {
      "scope": [
        "meta.embedded",
        "source.groovy.embedded",
        "source.java.embedded"
      ],
      "settings": {
        "foreground": "#334A56"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#416A7B",
