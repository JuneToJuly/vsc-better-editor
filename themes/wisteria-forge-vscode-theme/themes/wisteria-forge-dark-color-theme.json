  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#77727F",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#E35A5A",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#8CB0E1"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#A9AADE"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#D76B6B"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#E0A15C"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#E1E8F1"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#9FA7D6",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#7DA6D4"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#BF2B2B"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8F95D3"
      }
    },
    {
      "scope": [
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#FBFBFB",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "meta.annotation",
        "storage.type.annotation",
        "entity.name.function.annotation"
      ],
      "settings": {
        "foreground": "#D65B78"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "operator"
      ],
      "settings": {
        "foreground": "#C6C2CD"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#9893A1"
      }
    },
    {
      "scope": [
        "string.regexp",
        "constant.regexp"
      ],
      "settings": {
        "foreground": "#A593D9"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FF8A8A",
        "fontStyle": "underline"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#A4A0B3",
    "type": "#8CB0E1",
    "class": {
      "foreground": "#8CB0E1",
      "bold": true
    },
    "enum": "#8F95D3",
    "interface": "#8DA0C7",
    "struct": "#99A7CC",
    "typeParameter": "#9FA7D6",
    "parameter": {
      "foreground": "#9FA7D6",
      "italic": true
    },
    "variable": "#E1E8F1",
    "property": "#7DA6D4",
    "enumMember": {
      "foreground": "#FBFBFB",
      "bold": true
    },
    "function": "#A9AADE",
    "method": "#B3B4E5",
    "macro": "#E35A5A",
    "label": "#9499C5",
    "comment": {
      "foreground": "#77727F",
      "italic": true
    },
    "string": "#D76B6B",
    "number": "#E0A15C",
    "regexp": "#A593D9",
    "operator": "#C6C2CD",
    "decorator": "#D65B78",
    "keyword": {
      "foreground": "#E35A5A",
      "bold": true
    },
    "variable.readonly": "#F0EDF5",
    "property.readonly": "#C4C1D0",
    "method.declaration": {
      "foreground": "#9BA8D9",
      "bold": true
    },
    "function.declaration": {
      "foreground": "#9BA8D9",
      "bold": true
    },
    "class.declaration": {
      "foreground": "#8CB0E1",
      "bold": true
    }
  }
