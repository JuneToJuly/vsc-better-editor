      "foreground": "#242331",
      "bold": true
    },
    "function": "#6E68AE",
    "method": "#7872B8",
    "macro": "#BF2B2B",
    "label": "#626696",
    "comment": {
      "foreground": "#7D7983",
      "italic": true
    },
    "string": "#B23A3A",
    "number": "#B16B16",
    "regexp": "#6F66AF",
    "operator": "#5F5C67",
    "decorator": "#B63B56",
    "keyword": {
      "foreground": "#BF2B2B",
      "bold": true
    },
    "variable.readonly": "#383641",
    "property.readonly": "#5C5A65",
    "method.declaration": {
      "foreground": "#5A5F94",
      "bold": true
    },
    "function.declaration": {
      "foreground": "#5A5F94",
      "bold": true
