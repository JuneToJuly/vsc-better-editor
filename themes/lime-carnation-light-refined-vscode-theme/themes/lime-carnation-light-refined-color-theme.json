  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#786C81",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Control flow",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.return",
        "keyword.control.exception"
      ],
      "settings": {
        "foreground": "#C7337A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Language keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.declaration",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#743AB8"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#5A32D6"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "support.type",
        "support.class",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#4C3C87"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "identifier",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#342A40"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "meta.parameters"
      ],
      "settings": {
        "foreground": "#65566F"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#8A4F9C"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#65851A"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#A45B16"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#695E72"
      }
    },
    {
      "name": "Annotations",
      "scope": [
        "meta.annotation",
        "punctuation.definition.annotation",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#D148A0"
      }
    },
    {
      "name": "Namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.package",
        "support.type.namespace"
      ],
      "settings": {
        "foreground": "#8A4F9C"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#B8326A"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#8A4F9C",
    "type": "#4C3C87",
    "class": "#4C3C87",
    "enum": "#765183",
    "interface": "#4C3C87",
    "struct": "#4C3C87",
    "typeParameter": "#65566F",
    "parameter": "#65566F",
    "variable": "#342A40",
    "property": "#8A4F9C",
    "enumMember": "#A45B16",
    "event": "#D148A0",
    "function": "#5A32D6",
    "method": "#5A32D6",
    "macro": "#743AB8",
    "label": "#C7337A",
    "comment": {
      "foreground": "#786C81",
      "italic": true
    },
    "string": "#65851A",
    "number": "#A45B16",
    "regexp": "#718E20",
    "operator": "#695E72",
    "decorator": "#D148A0",
    "keyword": "#743AB8",
    "variable.readonly": "#A45B16",
    "property.readonly": "#96528C",
    "class.defaultLibrary": "#5A4996",
    "function.defaultLibrary": "#653BDD",
    "method.defaultLibrary": "#653BDD"
  }
}
