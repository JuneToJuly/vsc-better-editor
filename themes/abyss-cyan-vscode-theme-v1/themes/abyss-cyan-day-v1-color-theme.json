  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#74818F",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#38419D",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#2D6FA2"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#2A8F9C"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#287A76"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null"
      ],
      "settings": {
        "foreground": "#6C4B9B"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#27313A"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#4C5D77",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#3E5E9E"
      }
    },
    {
      "scope": [
        "constant.other",
        "variable.other.constant",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#5B4A99"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.package",
        "support.namespace"
      ],
      "settings": {
        "foreground": "#2D6FA2"
      }
    },
    {
      "scope": [
        "meta.annotation",
        "storage.type.annotation",
        "entity.name.type.annotation"
      ],
      "settings": {
        "foreground": "#3887BE"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#B00020",
        "fontStyle": "bold underline"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#20233A"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#27313A",
    "variable.readonly": "#5B4A99",
    "parameter": "#4C5D77",
    "property": "#2D6FA2",
    "enumMember": "#6C4B9B",
    "function": "#2A8F9C",
    "method": "#2A8F9C",
    "class": "#2D6FA2",
    "interface": "#2D6FA2",
    "enum": "#2D6FA2",
    "type": "#2D6FA2",
    "typeParameter": "#3887BE",
    "namespace": "#2D6FA2",
    "keyword": "#38419D",
    "operator": "#3E5E9E",
    "string": "#287A76",
    "number": "#6C4B9B",
    "regexp": "#247F86",
    "decorator": "#3887BE",
    "*.declaration": {
      "fontStyle": "bold"
    },
    "*.readonly": {
      "fontStyle": "italic"
    }
  }
}