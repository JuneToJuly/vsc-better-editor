  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#80898A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Control flow",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.return",
        "keyword.control.exception"
      ],
      "settings": {
        "foreground": "#D77AC8"
      }
    },
    {
      "name": "Declarations and modifiers",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.declaration",
        "keyword.operator.new",
        "keyword.package",
        "keyword.import"
      ],
      "settings": {
        "foreground": "#C069B5"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function",
        "meta.method-call"
      ],
      "settings": {
        "foreground": "#F6F8FF"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.type.class",
        "entity.name.type.interface",
        "support.type",
        "support.class",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#23CE6B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Annotations",
      "scope": [
        "meta.annotation",
        "punctuation.definition.annotation",
        "entity.name.function.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#C38CC0"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#8FE5B3"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "variable.other.constant",
        "constant.other"
      ],
      "settings": {
        "foreground": "#D5B86E"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "identifier",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#F0F2F7"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "meta.parameters"
      ],
      "settings": {
        "foreground": "#C4C9CF"
      }
    },
    {
      "name": "Properties and fields",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#C16BB8"
      }
    },
    {
      "name": "Packages and namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.package",
        "support.type.namespace"
      ],
      "settings": {
        "foreground": "#AEB6BA"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "punctuation.separator",
        "punctuation.accessor",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#AEB6BA"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#A846A0"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#AEB6BA",
    "type": "#23CE6B",
    "class": "#23CE6B",
    "class.declaration": {
      "foreground": "#23CE6B",
      "bold": true
    },
    "enum": "#23CE6B",
    "interface": "#23CE6B",
    "struct": "#23CE6B",
    "typeParameter": "#89DFAE",
    "parameter": "#C4C9CF",
    "variable": "#F0F2F7",
    "variable.readonly": "#D5B86E",
    "variable.static": "#D5B86E",
    "property": "#C16BB8",
    "property.readonly": "#D08CC8",
    "property.static": "#D08CC8",
    "enumMember": "#D5B86E",
    "function": "#F6F8FF",
    "function.declaration": "#F6F8FF",
    "method": "#F6F8FF",
    "method.declaration": "#F6F8FF",
    "function.defaultLibrary": "#FFFFFF",
    "method.defaultLibrary": "#FFFFFF",
    "decorator": "#C38CC0",
    "annotation": "#C38CC0",
    "macro": "#C069B5",
    "label": "#D77AC8",
    "keyword": "#C069B5",
    "modifier": "#C069B5",
    "operator": "#AEB6BA",
    "comment": {
      "foreground": "#80898A",
      "italic": true
    },
    "string": "#8FE5B3",
    "number": "#D5B86E",
    "regexp": "#79D7A0",
    "boolean": "#D5B86E",
    "null": "#D5B86E",
    "event": "#C38CC0"
  }
}
