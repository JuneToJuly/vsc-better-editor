  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7D7380",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#D186B0",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#C9A9D3"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#E8C6D7"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#B8CDA8"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#D8B783"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#DCE4EA"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#D59BB8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#A8C3D2"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#C77EA2"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#B69BC3"
      }
    },
    {
      "scope": [
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#F0D5E2",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "meta.annotation",
        "storage.type.annotation",
        "entity.name.function.annotation"
      ],
      "settings": {
        "foreground": "#E5A4C3"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "operator"
      ],
      "settings": {
        "foreground": "#B7AEBB"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#968A99"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#F18CA2",
        "fontStyle": "underline"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#B7A0C2",
    "type": "#C9A9D3",
    "class": {
      "foreground": "#D1AED9",
      "bold": true
    },
    "enum": "#C290D2",
    "interface": "#B29AC6",
    "typeParameter": "#D0A3BD",
    "parameter": {
      "foreground": "#D59BB8",
      "italic": true
    },
    "variable": "#DCE4EA",
    "property": "#A8C3D2",
    "enumMember": {
      "foreground": "#F0D5E2",
      "bold": true
    },
    "function": "#E8C6D7",
    "method": "#E9B8D0",
    "comment": {
      "foreground": "#7D7380",
      "italic": true
    },
    "string": "#B8CDA8",
    "number": "#D8B783",
    "operator": "#B7AEBB",
    "decorator": "#E5A4C3",
    "keyword": {
      "foreground": "#D186B0",
      "bold": true
    },
    "method.declaration": {
      "foreground": "#E6ADC9",
      "bold": true
    },
    "function.declaration": {
      "foreground": "#E6ADC9",
      "bold": true
    },
    "class.declaration": {
      "foreground": "#D1AED9",
      "bold": true
    }
  }
}
