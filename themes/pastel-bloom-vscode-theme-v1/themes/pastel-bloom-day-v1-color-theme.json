  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#9E8E98", "fontStyle": "italic" }
    },
    {
      "name": "Documentation comments",
      "scope": ["comment.block.documentation", "comment.block.javadoc", "storage.type.class.jsdoc"],
      "settings": { "foreground": "#8E7C88", "fontStyle": "italic" }
    },
    {
      "name": "Keywords and control flow",
      "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier", "variable.language"],
      "settings": { "foreground": "#C636BC", "fontStyle": "bold" }
    },
    {
      "name": "Types and classes",
      "scope": ["entity.name.type", "entity.name.class", "entity.name.interface", "support.type", "support.class", "storage.type.annotation.java"],
      "settings": { "foreground": "#A54CA0" }
    },
    {
      "name": "Functions and methods",
      "scope": ["entity.name.function", "meta.function-call", "support.function", "variable.function", "entity.name.method"],
      "settings": { "foreground": "#B07A00", "fontStyle": "bold" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
      "settings": { "foreground": "#7A751F" }
    },
    {
      "name": "Numbers and constants",
      "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other", "support.constant"],
      "settings": { "foreground": "#D07442" }
    },
    {
      "name": "Annotations and decorators",
      "scope": ["entity.name.type.annotation", "meta.declaration.annotation", "punctuation.definition.annotation", "meta.annotation"],
      "settings": { "foreground": "#D64ECD", "fontStyle": "bold" }
    },
    {
      "name": "Properties and fields",
      "scope": ["variable.other.property", "variable.other.object.property", "variable.other.member", "support.variable.property"],
      "settings": { "foreground": "#73556D" }
    },
    {
      "name": "Variables and parameters",
      "scope": ["variable", "variable.parameter", "meta.definition.variable.name"],
      "settings": { "foreground": "#4A3F46" }
    },
    {
      "name": "Namespaces and packages",
      "scope": ["entity.name.namespace", "entity.name.package", "meta.import", "meta.package"],
      "settings": { "foreground": "#7D668E" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.accessor", "punctuation.separator", "punctuation.terminator"],
      "settings": { "foreground": "#8A5C7F" }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "meta.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#C636BC" }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name", "support.type.property-name.css"],
      "settings": { "foreground": "#B07A00" }
    },
    {
      "name": "Regex",
      "scope": ["string.regexp", "constant.other.character-class.regexp", "keyword.operator.quantifier.regexp"],
      "settings": { "foreground": "#9A5A7F" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": { "foreground": "#B137A9", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#8A4D9B", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#9E6C87", "fontStyle": "italic" }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#A54CA0", "fontStyle": "underline" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#FFFDF9", "background": "#C43D67" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#7D668E",
    "type": "#A54CA0",
    "class": "#A54CA0",
    "interface": "#A54CA0",
    "enum": "#A54CA0",
    "typeParameter": "#9B5C96",
    "parameter": "#6B5963",
    "variable": "#4A3F46",
    "property": "#73556D",
    "enumMember": "#D07442",
    "decorator": { "foreground": "#D64ECD", "bold": true },
    "event": "#B137A9",
    "function": { "foreground": "#B07A00", "bold": true },
    "method": { "foreground": "#B07A00", "bold": true },
    "macro": "#C636BC",
    "label": "#8A4D9B",
    "comment": { "foreground": "#9E8E98", "italic": true },
    "string": "#7A751F",
    "number": "#D07442",
    "regexp": "#9A5A7F",
    "operator": "#8A5C7F",
    "keyword": { "foreground": "#C636BC", "bold": true },
    "modifier": "#B14BAA",
    "*.declaration": { "bold": true },
    "*.readonly": "#91648C",
    "*.static": "#9A5A7F",
    "*.deprecated": { "foreground": "#A997A2", "strikethrough": true },
    "variable.defaultLibrary": "#8A4D9B",
    "function.defaultLibrary": "#9A5A7F",
    "method.defaultLibrary": "#9A5A7F"
  }
}
