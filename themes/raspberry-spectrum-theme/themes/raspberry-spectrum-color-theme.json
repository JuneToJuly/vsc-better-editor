  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {"foreground": "#776A7A", "fontStyle": "italic"}
    },
    {
      "scope": ["comment.documentation", "string.quoted.docstring"],
      "settings": {"foreground": "#95889A", "fontStyle": "italic"}
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new", "keyword.operator.expression", "keyword.other.using"],
      "settings": {"foreground": "#FF6687", "fontStyle": "bold"}
    },
    {
      "scope": ["keyword.operator", "keyword.operator.assignment", "keyword.operator.comparison", "keyword.operator.logical", "keyword.operator.arithmetic"],
      "settings": {"foreground": "#B79BFF"}
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "entity.name.struct", "entity.name.enum", "support.class", "support.type"],
      "settings": {"foreground": "#CEBBC9"}
    },
    {
      "scope": ["entity.name.interface", "entity.name.trait", "storage.type.interface"],
      "settings": {"foreground": "#D7C8D4", "fontStyle": "italic"}
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"],
      "settings": {"foreground": "#8C9BFF"}
    },
    {
      "scope": ["entity.name.method", "meta.method-call", "support.function.any-method"],
      "settings": {"foreground": "#7485FF"}
    },
    {
      "scope": ["variable", "meta.definition.variable.name"],
      "settings": {"foreground": "#EDE6EE"}
    },
    {
      "scope": ["variable.parameter", "meta.function.parameters"],
      "settings": {"foreground": "#EAA4B8", "fontStyle": "italic"}
    },
    {
      "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property"],
      "settings": {"foreground": "#D6C6D2"}
    },
    {
      "scope": ["variable.language", "variable.language.this", "variable.language.self", "variable.language.super"],
      "settings": {"foreground": "#CE2D4F", "fontStyle": "italic"}
    },
    {
      "scope": ["constant", "constant.language", "support.constant", "variable.other.constant"],
      "settings": {"foreground": "#B893D7"}
    },
    {
      "scope": ["constant.numeric", "constant.numeric.integer", "constant.numeric.float"],
      "settings": {"foreground": "#A97CFF"}
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {"foreground": "#D8B2C0"}
    },
    {
      "scope": ["constant.character.escape", "string.regexp", "constant.other.character-class.regexp"],
      "settings": {"foreground": "#FF8BA7"}
    },
    {
      "scope": ["entity.name.tag", "support.class.component"],
      "settings": {"foreground": "#FF6687"}
    },
    {
      "scope": ["entity.other.attribute-name", "meta.attribute", "support.type.property-name"],
      "settings": {"foreground": "#8C9BFF"}
    },
    {
      "scope": ["entity.name.namespace", "entity.name.package", "support.other.namespace"],
      "settings": {"foreground": "#CE6D8B"}
    },
    {
      "scope": ["entity.name.label", "constant.other.label"],
      "settings": {"foreground": "#CE6D8B", "fontStyle": "italic"}
    },
    {
      "scope": ["meta.annotation", "storage.type.annotation", "punctuation.definition.annotation"],
      "settings": {"foreground": "#B893D7"}
    },
    {
      "scope": ["punctuation", "meta.brace", "meta.delimiter", "punctuation.separator", "punctuation.terminator"],
      "settings": {"foreground": "#A99CAB"}
    },
    {
      "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
      "settings": {"foreground": "#FFFFFF", "background": "#CE2D4F", "fontStyle": "bold underline"}
    },
    {
      "scope": ["markup.heading", "markup.heading entity.name"],
      "settings": {"foreground": "#CE6D8B", "fontStyle": "bold"}
    },
    {
      "scope": ["markup.bold"],
      "settings": {"foreground": "#F5EEF5", "fontStyle": "bold"}
    },
    {
      "scope": ["markup.italic"],
      "settings": {"foreground": "#CEBBC9", "fontStyle": "italic"}
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": {"foreground": "#AEB9FF"}
    },
    {
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": {"foreground": "#C5A4DF"}
    },
    {
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": {"foreground": "#FF6687"}
    },
    {
      "scope": ["markup.changed"],
      "settings": {"foreground": "#7485FF"}
    },
    {
      "scope": ["markup.underline.link", "string.other.link", "meta.link"],
      "settings": {"foreground": "#8C9BFF", "fontStyle": "underline"}
    }
  ],
  "semanticTokenColors": {
    "namespace": "#CE6D8B",
    "type": "#CEBBC9",
    "type.defaultLibrary": "#D7C8D4",
    "class": "#CEBBC9",
    "class.defaultLibrary": "#D7C8D4",
    "enum": "#CEBBC9",
    "interface": {"foreground": "#D7C8D4", "italic": true},
    "struct": "#CEBBC9",
    "typeParameter": {"foreground": "#B893D7", "italic": true},
    "parameter": {"foreground": "#EAA4B8", "italic": true},
    "variable": "#EDE6EE",
    "variable.readonly": "#B893D7",
    "variable.defaultLibrary": {"foreground": "#CE2D4F", "italic": true},
    "property": "#D6C6D2",
    "property.readonly": "#B893D7",
    "enumMember": "#B893D7",
    "decorator": "#B893D7",
    "event": "#CE6D8B",
    "function": "#8C9BFF",
    "function.defaultLibrary": "#AEB9FF",
    "method": "#7485FF",
    "macro": "#A97CFF",
    "label": {"foreground": "#CE6D8B", "italic": true},
    "comment": {"foreground": "#776A7A", "italic": true},
    "string": "#D8B2C0",
    "number": "#A97CFF",
    "regexp": "#FF8BA7",
    "operator": "#B79BFF",
    "keyword": {"foreground": "#FF6687", "bold": true},
    "modifier": "#FF6687"
  }
}
