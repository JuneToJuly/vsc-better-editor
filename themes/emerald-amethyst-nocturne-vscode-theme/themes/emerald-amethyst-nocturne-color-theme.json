  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#738287",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Control flow",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.return",
        "keyword.control.exception"
      ],
      "settings": {
        "foreground": "#C879C2"
      }
    },
    {
      "name": "Declarations and modifiers",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.declaration",
        "keyword.operator.new",
        "keyword.package",
        "keyword.import"
      ],
      "settings": {
        "foreground": "#B765B0"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.type.class",
        "entity.name.type.interface",
        "support.type",
        "support.class",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#39D77A"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function",
        "meta.method-call",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#F3F6FA"
      }
    },
    {
      "name": "Annotations",
      "scope": [
        "meta.annotation",
        "punctuation.definition.annotation",
        "entity.name.function.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#C58AC1"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#66DC99"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "variable.other.constant",
        "constant.other"
      ],
      "settings": {
        "foreground": "#D6B96D"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "identifier",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#F0F3F4"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "meta.parameters"
      ],
      "settings": {
        "foreground": "#C5CDD0"
      }
    },
    {
      "name": "Properties and fields",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#B672B1"
      }
    },
    {
      "name": "Packages and namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.package",
        "support.type.namespace"
      ],
      "settings": {
        "foreground": "#AAB6BA"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "punctuation.separator",
        "punctuation.accessor",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#AEB9BC"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#A846A0"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#AAB6BA",
    "type": "#39D77A",
    "class": "#39D77A",
    "class.declaration": "#39D77A",
    "enum": "#39D77A",
    "interface": "#39D77A",
    "struct": "#39D77A",
    "typeParameter": "#8DE6B2",
    "parameter": "#C5CDD0",
    "variable": "#F0F3F4",
    "variable.readonly": "#D6B96D",
    "variable.static": "#D6B96D",
    "property": "#B672B1",
    "property.readonly": "#C68DC2",
    "property.static": "#C68DC2",
    "enumMember": "#D6B96D",
    "function": "#F3F6FA",
    "function.declaration": "#F3F6FA",
    "method": "#F3F6FA",
    "method.declaration": "#F3F6FA",
    "function.defaultLibrary": "#FFFFFF",
    "method.defaultLibrary": "#FFFFFF",
    "decorator": "#C58AC1",
    "annotation": "#C58AC1",
    "macro": "#B765B0",
    "label": "#C879C2",
    "keyword": "#B765B0",
    "modifier": "#B765B0",
    "operator": "#AEB9BC",
    "comment": {
      "foreground": "#738287",
      "italic": true
    },
    "string": "#66DC99",
    "number": "#D6B96D",
    "regexp": "#79DFA5",
    "boolean": "#D6B96D",
    "null": "#D6B96D",
    "event": "#C58AC1"
  }
}
