    "minimapSlider.hoverBackground": "#DE1A5855",
    "minimapSlider.activeBackground": "#DE1A5877",
    "scrollbarSlider.background": "#8A607744",
    "scrollbarSlider.hoverBackground": "#8A607766",
    "scrollbarSlider.activeBackground": "#DE1A5888",
    "gitDecoration.addedResourceForeground": "#63C98B",
    "gitDecoration.modifiedResourceForeground": "#B39CFF",
    "gitDecoration.deletedResourceForeground": "#FF5B8D",
    "gitDecoration.untrackedResourceForeground": "#FF76D7",
    "testing.iconPassed": "#63C98B",
    "testing.iconFailed": "#FF5B8D",
    "testing.iconQueued": "#FFB36B"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9F8493",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#FF58D8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#8E80FF"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#FF5B8D"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#FF9A59"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null"
      ],
      "settings": {
        "foreground": "#FFB36B"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#F3DCE7"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#E8A9D6",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#FF76D7"
      }
    },
    {
      "scope": [
        "constant.other",
        "variable.other.constant",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#FFC27E"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.package",
        "support.namespace"
      ],
      "settings": {
        "foreground": "#8E80FF"
      }
    },
    {
      "scope": [
        "meta.annotation",
        "storage.type.annotation",
        "entity.name.type.annotation"
      ],
      "settings": {
        "foreground": "#B39CFF"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#FF58D8"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#FF5B8D"
      }
    },
    {
      "scope": [
        "markup.heading",
        "markup.bold"
      ],
      "settings": {
        "foreground": "#FF58D8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#8E80FF",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#FF9A59"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FF6A7D",
        "fontStyle": "bold underline"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#F7EAF2"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#F3DCE7",
    "variable.readonly": "#FFC27E",
    "parameter": "#E8A9D6",
    "property": "#FF76D7",
    "enumMember": "#FFB36B",
    "function": "#FF5B8D",
    "method": "#FF5B8D",
    "class": "#8E80FF",
    "interface": "#8E80FF",
    "enum": "#8E80FF",
    "type": "#8E80FF",
    "typeParameter": "#B39CFF",
    "namespace": "#8E80FF",
    "keyword": "#FF58D8",
    "operator": "#FF76D7",
    "string": "#FF9A59",
    "number": "#FFB36B",
    "regexp": "#FFC27E",
    "decorator": "#B39CFF",
    "*.declaration": {
      "fontStyle": "bold"
    },
    "*.readonly": {
      "fontStyle": "italic"
    }
  }
}