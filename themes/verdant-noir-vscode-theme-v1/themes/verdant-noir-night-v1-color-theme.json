    "terminal.ansiBrightYellow": "#E6F38F",
    "terminal.ansiGreen": "#5EC783",
    "terminal.ansiBrightGreen": "#8FE1A7",
    "terminal.ansiCyan": "#72BCA5",
    "terminal.ansiBrightCyan": "#9ADCC7"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#929B86",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#A7D129",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#B7C98B"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#C9E36A"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#B8D46E"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null"
      ],
      "settings": {
        "foreground": "#D3E66F"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#E6EBDD"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#BAC4AC",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#AFCB59"
      }
    },
    {
      "scope": [
        "constant.other",
        "variable.other.constant",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#C9E36A"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.package",
        "support.namespace"
      ],
      "settings": {
        "foreground": "#B7C98B"
      }
    },
    {
      "scope": [
        "meta.annotation",
        "storage.type.annotation",
        "entity.name.type.annotation"
      ],
      "settings": {
        "foreground": "#9DBD58"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FF6F7D",
        "fontStyle": "bold underline"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#E8EEDC"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#E6EBDD",
    "variable.readonly": "#C9E36A",
    "parameter": "#BAC4AC",
    "property": "#B4CE63",
    "enumMember": "#D3E66F",
    "function": "#C9E36A",
    "method": "#C9E36A",
    "class": "#B7C98B",
    "interface": "#B7C98B",
    "enum": "#B7C98B",
    "type": "#B7C98B",
    "typeParameter": "#9DBD58",
    "namespace": "#B7C98B",
    "keyword": "#A7D129",
    "operator": "#AFCB59",
    "string": "#B8D46E",
    "number": "#D3E66F",
    "regexp": "#C8DB76",
    "decorator": "#9DBD58",
    "*.declaration": {
      "fontStyle": "bold"
    },
    "*.readonly": {
      "fontStyle": "italic"
    }
  }
}