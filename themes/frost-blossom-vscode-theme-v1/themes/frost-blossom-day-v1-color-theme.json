  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8992A3",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#8E72C9",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#3C9AC8"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#4E86C7"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#B65A98"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null"
      ],
      "settings": {
        "foreground": "#7A68B9"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#343744"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#6F6A89",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#6B79B7"
      }
    },
    {
      "scope": [
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#2D8DA7"
      }
    },
    {
      "scope": [
        "meta.annotation",
        "entity.name.type.annotation"
      ],
      "settings": {
        "foreground": "#7C62BE"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#343744",
    "parameter": "#6F6A89",
    "property": "#4E86C7",
    "function": "#4E86C7",
    "method": "#4E86C7",
    "class": "#3C9AC8",
    "interface": "#3C9AC8",
    "enum": "#3C9AC8",
    "type": "#3C9AC8",
    "namespace": "#3C9AC8",
    "keyword": "#8E72C9",
    "operator": "#6B79B7",
    "string": "#B65A98",
    "number": "#7A68B9",
    "decorator": "#7C62BE",
    "*.declaration": {
      "fontStyle": "bold"
    },
    "*.readonly": {
      "fontStyle": "italic"
    }
  }
}