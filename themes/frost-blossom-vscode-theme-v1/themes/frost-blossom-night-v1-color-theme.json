  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8D98A8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#CABBE9",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#A1EAFB"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#91CFF2"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#FFCEF3"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null"
      ],
      "settings": {
        "foreground": "#D8C8F1"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#E9EDF2"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#C9C5D8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#B4BDEB"
      }
    },
    {
      "scope": [
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#B4F2FA"
      }
    },
    {
      "scope": [
        "meta.annotation",
        "entity.name.type.annotation"
      ],
      "settings": {
        "foreground": "#D3C3EF"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#E9EDF2",
    "parameter": "#C9C5D8",
    "property": "#91CFF2",
    "function": "#91CFF2",
    "method": "#91CFF2",
    "class": "#A1EAFB",
    "interface": "#A1EAFB",
    "enum": "#A1EAFB",
    "type": "#A1EAFB",
    "namespace": "#A1EAFB",
    "keyword": "#CABBE9",
    "operator": "#B4BDEB",
    "string": "#FFCEF3",
    "number": "#D8C8F1",
    "decorator": "#D3C3EF",
    "*.declaration": {
      "fontStyle": "bold"
    },
    "*.readonly": {
      "fontStyle": "italic"
    }
  }
}