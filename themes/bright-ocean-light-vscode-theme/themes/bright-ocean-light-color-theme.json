    "notifications.foreground": "#342E37",
    "notifications.border": "#C8D4D0",
    "notificationLink.foreground": "#1F72C2",
    "quickInput.background": "#FFFFFF",
    "quickInput.foreground": "#342E37",
    "quickInputList.focusBackground": "#DCEEFE",
    "quickInputList.focusForeground": "#342E37",
    "menu.background": "#FFFFFF",
    "menu.foreground": "#342E37",
    "menu.selectionBackground": "#DCEEFE",
