    "menu.separatorBackground": "#D9E1DE",
    "menu.border": "#C8D4D0",
    "progressBar.background": "#3C91E6"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7B7580",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Control flow",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.return",
        "keyword.control.exception"
      ],
      "settings": {
        "foreground": "#D85E36",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Language keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.declaration",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#A74C2D"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#1F72C2"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "support.type",
        "support.class",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#5E4770"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "identifier",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#342E37"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "meta.parameters"
      ],
      "settings": {
        "foreground": "#675F6A"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#2E7E87"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#5F8E22"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#B65C24"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#6C6670"
      }
    },
    {
      "name": "Annotations",
      "scope": [
        "meta.annotation",
        "punctuation.definition.annotation",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#8D4B80"
      }
    },
    {
      "name": "Namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.package",
        "support.type.namespace"
      ],
      "settings": {
        "foreground": "#2E7E87"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#C63C32"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#2E7E87",
    "type": "#5E4770",
    "class": "#5E4770",
    "enum": "#7A5A3A",
    "interface": "#5E4770",
    "struct": "#5E4770",
    "typeParameter": "#675F6A",
    "parameter": "#675F6A",
    "variable": "#342E37",
    "property": "#2E7E87",
    "enumMember": "#B65C24",
    "event": "#8D4B80",
    "function": "#1F72C2",
    "method": "#1F72C2",
    "macro": "#A74C2D",
    "label": "#D85E36",
    "comment": {
      "foreground": "#7B7580",
      "italic": true
    },
    "string": "#5F8E22",
    "number": "#B65C24",
    "regexp": "#668D2C",
    "operator": "#6C6670",
    "decorator": "#8D4B80",
    "keyword": "#A74C2D",
    "variable.readonly": "#B65C24",
    "property.readonly": "#A75C2F",
    "class.defaultLibrary": "#70527C",
    "function.defaultLibrary": "#287FC9",
    "method.defaultLibrary": "#287FC9"
  }
}
