    "menu.separatorBackground": "#E2D9EA",
    "menu.border": "#D4C8DE",
    "progressBar.background": "#724CF9"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#82778B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Control flow",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.return",
        "keyword.control.exception"
      ],
      "settings": {
        "foreground": "#C53B85",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Language keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.declaration",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#7A42C2"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#5B36D6"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "support.type",
        "support.class",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#564592"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "identifier",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#3A2E49"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "meta.parameters"
      ],
      "settings": {
        "foreground": "#695C73"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#8A4F9C"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#71851D"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#A66B19"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#766B7D"
      }
    },
    {
      "name": "Annotations",
      "scope": [
        "meta.annotation",
        "punctuation.definition.annotation",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#D152A5"
      }
    },
    {
      "name": "Namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.package",
        "support.type.namespace"
      ],
      "settings": {
        "foreground": "#8A4F9C"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#B8326A"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#8A4F9C",
    "type": "#564592",
    "class": "#564592",
    "enum": "#805B92",
    "interface": "#564592",
    "struct": "#564592",
    "typeParameter": "#695C73",
    "parameter": "#695C73",
    "variable": "#3A2E49",
    "property": "#8A4F9C",
    "enumMember": "#A66B19",
    "event": "#D152A5",
    "function": "#5B36D6",
    "method": "#5B36D6",
    "macro": "#7A42C2",
    "label": "#C53B85",
    "comment": {
      "foreground": "#82778B",
      "italic": true
    },
    "string": "#71851D",
    "number": "#A66B19",
    "regexp": "#7A8E23",
    "operator": "#766B7D",
    "decorator": "#D152A5",
    "keyword": "#7A42C2",
    "variable.readonly": "#A66B19",
    "property.readonly": "#9A5E93",
    "class.defaultLibrary": "#6A56A6",
    "function.defaultLibrary": "#6842E0",
    "method.defaultLibrary": "#6842E0"
  }
}
