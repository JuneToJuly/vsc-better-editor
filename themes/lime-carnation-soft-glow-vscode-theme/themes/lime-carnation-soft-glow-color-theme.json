  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#81758B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Control flow",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.return",
        "keyword.control.exception"
      ],
      "settings": {
        "foreground": "#D24B91",
        "fontStyle": ""
      }
    },
    {
      "name": "Language keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.declaration",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#6840B9"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#3F36C8"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "support.type",
        "support.class",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#4A3A85"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "identifier",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#30273C"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "meta.parameters"
      ],
      "settings": {
        "foreground": "#655A70"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#7660A2"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#5D861E"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#A45A20"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#6E6476"
      }
    },
    {
      "name": "Annotations",
      "scope": [
        "meta.annotation",
        "punctuation.definition.annotation",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#D44A9B"
      }
    },
    {
      "name": "Namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.package",
        "support.type.namespace"
      ],
      "settings": {
        "foreground": "#8A4F9C"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#B8326A"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#7660A2",
    "type": "#4A3A85",
    "class": "#4A3A85",
    "enum": "#725088",
    "interface": "#4A3A85",
    "struct": "#4A3A85",
    "typeParameter": "#655A70",
    "parameter": "#655A70",
    "variable": "#30273C",
    "property": "#7660A2",
    "enumMember": "#A45A20",
    "event": "#D44A9B",
    "function": "#3F36C8",
    "method": "#3F36C8",
    "macro": "#6840B9",
    "label": "#D24B91",
    "comment": {
      "foreground": "#81758B",
      "italic": true
    },
    "string": "#5D861E",
    "number": "#A45A20",
    "regexp": "#688B25",
    "operator": "#6E6476",
    "decorator": "#D44A9B",
    "keyword": "#6840B9",
    "variable.readonly": "#A45A20",
    "property.readonly": "#8D5488",
    "class.defaultLibrary": "#5A4895",
    "function.defaultLibrary": "#4B3BD2",
    "method.defaultLibrary": "#4B3BD2"
  }
}
