  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#817785",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#7D16D0",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#A33FB7"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#8F22D5"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#8C6A00"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null"
      ],
      "settings": {
        "foreground": "#9B7200"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#29232D"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#6F4D7A",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#A93EB8"
      }
    },
    {
      "scope": [
        "constant.other",
        "variable.other.constant",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#7E5D00"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.package",
        "support.namespace"
      ],
      "settings": {
        "foreground": "#A33FB7"
      }
    },
    {
      "scope": [
        "meta.annotation",
        "storage.type.annotation",
        "entity.name.type.annotation"
      ],
      "settings": {
        "foreground": "#9929EA"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#B00020",
        "fontStyle": "bold underline"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#211B24"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#29232D",
    "variable.readonly": "#7E5D00",
    "parameter": "#6F4D7A",
    "property": "#A33FB7",
    "enumMember": "#9B7200",
    "function": "#8F22D5",
    "method": "#8F22D5",
    "class": "#A33FB7",
    "interface": "#A33FB7",
    "enum": "#A33FB7",
    "type": "#A33FB7",
    "typeParameter": "#9929EA",
    "namespace": "#A33FB7",
    "keyword": "#7D16D0",
    "operator": "#A93EB8",
    "string": "#8C6A00",
    "number": "#9B7200",
    "regexp": "#A37B00",
    "decorator": "#9929EA",
    "*.declaration": {
      "fontStyle": "bold"
    },
    "*.readonly": {
      "fontStyle": "italic"
    }
  }
}