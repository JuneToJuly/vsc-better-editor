    "terminal.ansiRed": "#FF6B85",
    "terminal.ansiBrightRed": "#FF9AAF",
    "terminal.ansiYellow": "#FAEB92",
    "terminal.ansiBrightYellow": "#FFF2B6",
    "terminal.ansiGreen": "#5EC783",
    "terminal.ansiBrightGreen": "#8FE1A7",
    "terminal.ansiCyan": "#68C1D0",
    "terminal.ansiBrightCyan": "#96E5F0"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8D8392",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#B85CFF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#E08CF0"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#CF6FFF"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#FAEB92"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null"
      ],
      "settings": {
        "foreground": "#FFE8A6"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#EEE7F1"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#D4B5DD",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#D991E5"
      }
    },
    {
      "scope": [
        "constant.other",
        "variable.other.constant",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#FAEB92"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.package",
        "support.namespace"
      ],
      "settings": {
        "foreground": "#E08CF0"
      }
    },
    {
      "scope": [
        "meta.annotation",
        "storage.type.annotation",
        "entity.name.type.annotation"
      ],
      "settings": {
        "foreground": "#C977FF"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FF6B85",
        "fontStyle": "bold underline"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#F4EDF7"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#EEE7F1",
    "variable.readonly": "#FAEB92",
    "parameter": "#D4B5DD",
    "property": "#E08CF0",
    "enumMember": "#FFE8A6",
    "function": "#CF6FFF",
    "method": "#CF6FFF",
    "class": "#E08CF0",
    "interface": "#E08CF0",
    "enum": "#E08CF0",
    "type": "#E08CF0",
    "typeParameter": "#C977FF",
    "namespace": "#E08CF0",
    "keyword": "#B85CFF",
    "operator": "#D991E5",
    "string": "#FAEB92",
    "number": "#FFE8A6",
    "regexp": "#FFF0B2",
    "decorator": "#C977FF",
    "*.declaration": {
      "fontStyle": "bold"
    },
    "*.readonly": {
      "fontStyle": "italic"
    }
  }
}