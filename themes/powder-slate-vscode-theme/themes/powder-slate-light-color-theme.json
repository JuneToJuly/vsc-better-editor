  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8C7880",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#8A4F2C"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#8C5B2B"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#3B60E4"
      }
    },
    {
      "name": "Control flow",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.return",
        "keyword.control.throw"
      ],
      "settings": {
        "foreground": "#7765E3"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#5D4FC8"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#3D4B9C"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#3D3440"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#6B4A70"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#665762"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#75656E"
      }
    },
    {
      "name": "Annotations and decorators",
      "scope": [
        "meta.annotation",
        "entity.name.type.annotation",
        "punctuation.definition.annotation",
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#9B4F96"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#B23A48"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#5D4FC8",
    "type": "#3D4B9C",
    "class": "#3D4B9C",
    "enum": "#3D4B9C",
    "interface": "#3D4B9C",
    "struct": "#3D4B9C",
    "typeParameter": "#7765E3",
    "parameter": "#3D3440",
    "variable": "#3D3440",
    "property": "#6B4A70",
    "enumMember": "#8C5B2B",
    "decorator": "#9B4F96",
    "event": "#5D4FC8",
    "function": "#5D4FC8",
    "method": "#5D4FC8",
    "macro": "#7765E3",
    "label": "#3B60E4",
    "comment": {
      "foreground": "#8C7880",
      "italic": true
    },
    "string": "#8A4F2C",
    "number": "#8C5B2B",
    "regexp": "#A0496D",
    "operator": "#665762",
    "keyword": "#3B60E4"
  }
}
