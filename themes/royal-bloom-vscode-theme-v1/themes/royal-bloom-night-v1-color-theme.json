  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#8F819B", "fontStyle": "italic" }
    },
    {
      "name": "Documentation",
      "scope": ["comment.block.documentation", "comment.line.documentation", "string.quoted.docstring"],
      "settings": { "foreground": "#A998B4", "fontStyle": "italic" }
    },
    {
      "name": "Keywords and control flow",
      "scope": [
        "keyword", "keyword.control", "keyword.operator.new", "keyword.operator.expression",
        "storage.type", "storage.modifier", "keyword.other.import", "keyword.other.package"
      ],
      "settings": { "foreground": "#FF6663", "fontStyle": "bold" }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type", "entity.name.class", "entity.name.interface", "entity.name.enum",
        "support.type", "support.class", "meta.type.annotation entity.name.type"
      ],
      "settings": { "foreground": "#DF99F0" }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function", "support.function", "meta.function-call", "variable.function",
        "meta.method-call", "entity.name.method"
      ],
      "settings": { "foreground": "#E0FF4F" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#B8E86F" }
    },
    {
      "name": "String escapes",
      "scope": ["constant.character.escape", "constant.other.placeholder"],
      "settings": { "foreground": "#B191FF", "fontStyle": "bold" }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#FFB08C" }
    },
    {
      "name": "Booleans and null",
      "scope": ["constant.language.boolean", "constant.language.null", "constant.language.undefined"],
      "settings": { "foreground": "#FF91B2", "fontStyle": "bold" }
    },
    {
      "name": "Constants and enum members",
      "scope": ["constant.other", "variable.other.constant", "variable.other.enummember"],
      "settings": { "foreground": "#E0FF4F" }
    },
    {
      "name": "Annotations and decorators",
      "scope": ["meta.annotation", "entity.name.function.decorator", "punctuation.definition.annotation"],
      "settings": { "foreground": "#B191FF" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other", "meta.definition.variable.name"],
      "settings": { "foreground": "#EEE8F4" }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#CDBFFF", "fontStyle": "italic" }
    },
    {
      "name": "Fields and properties",
      "scope": ["variable.other.property", "variable.other.member", "support.variable.property"],
      "settings": { "foreground": "#D8C7E5" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.accessor", "punctuation.separator"],
      "settings": { "foreground": "#B191FF" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace", "meta.delimiter"],
      "settings": { "foreground": "#B9ACC5" }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#FF6663" }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#DF99F0" }
    },
    {
      "name": "Markup headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#DF99F0", "fontStyle": "bold" }
    },
    {
      "name": "Markup bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#E0FF4F", "fontStyle": "bold" }
    },
    {
      "name": "Markup italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#B191FF", "fontStyle": "italic" }
    },
    {
      "name": "Markup links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#B191FF", "fontStyle": "underline" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#FFFFFF", "background": "#B93646" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#B191FF",
    "type": "#DF99F0",
    "class": { "foreground": "#DF99F0", "bold": true },
    "enum": "#DF99F0",
    "interface": "#C99BEF",
    "struct": "#D8A8EE",
    "typeParameter": "#CDBFFF",
    "parameter": { "foreground": "#CDBFFF", "italic": true },
    "variable": "#EEE8F4",
    "property": "#D8C7E5",
    "enumMember": { "foreground": "#E0FF4F", "bold": true },
    "decorator": "#B191FF",
    "event": "#FF91B2",
    "function": "#E0FF4F",
    "method": "#E0FF4F",
    "macro": "#FF6663",
    "label": "#DF99F0",
    "comment": { "foreground": "#8F819B", "italic": true },
    "string": "#B8E86F",
    "number": "#FFB08C",
    "regexp": "#FF91B2",
    "operator": "#B191FF",
    "keyword": { "foreground": "#FF6663", "bold": true },
    "modifier": "#FF6663",
    "builtinType": "#DF99F0",
    "selfKeyword": { "foreground": "#B191FF", "italic": true },
    "newOperator": "#FF6663",
    "static": { "foreground": "#E0FF4F", "underline": true },
    "readonly": "#E0FF4F",
    "deprecated": { "foreground": "#8C7D95", "strikethrough": true },
    "declaration": { "bold": true },
    "defaultLibrary": "#CFAEFF"
  }
}
