    "breadcrumb.background": "#10272D",
    "breadcrumb.foreground": "#7FA39D",
    "breadcrumb.focusForeground": "#92EEFF",
    "minimapSlider.background": "#30AFFF33",
    "minimapSlider.hoverBackground": "#30AFFF55",
    "minimapSlider.activeBackground": "#30AFFF77",
    "scrollbarSlider.background": "#5C8A8244",
    "scrollbarSlider.hoverBackground": "#5C8A8266",
    "scrollbarSlider.activeBackground": "#30AFFF88",
    "gitDecoration.addedResourceForeground": "#7BE6A4",
    "gitDecoration.modifiedResourceForeground": "#92EEFF",
    "gitDecoration.deletedResourceForeground": "#FF6B7A",
    "gitDecoration.untrackedResourceForeground": "#C4F7CA",
    "testing.iconPassed": "#7BE6A4",
    "testing.iconFailed": "#FF6B7A",
    "testing.iconQueued": "#FFD166"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#73958F",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#30AFFF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#92EEFF"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#D8FFC5"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#C4F7CA"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null"
      ],
      "settings": {
        "foreground": "#FFD166"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#E7F7F4"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#D6C8FF",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#7DDFFF"
      }
    },
    {
      "scope": [
        "constant.other",
        "variable.other.constant",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#F7D774"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.package",
        "support.namespace"
      ],
      "settings": {
        "foreground": "#92EEFF"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#30AFFF"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#D8FFC5"
      }
    },
    {
      "scope": [
        "markup.heading",
        "markup.bold"
      ],
      "settings": {
        "foreground": "#30AFFF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#92EEFF",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#C4F7CA"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FF6B7A",
        "fontStyle": "bold underline"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#D9F7F1"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#E7F7F4",
    "variable.readonly": "#F7D774",
    "parameter": "#D6C8FF",
    "property": "#7DDFFF",
    "enumMember": "#F7D774",
    "function": "#D8FFC5",
    "method": "#D8FFC5",
    "class": "#92EEFF",
    "interface": "#92EEFF",
    "enum": "#92EEFF",
    "type": "#92EEFF",
    "typeParameter": "#30AFFF",
    "namespace": "#92EEFF",
    "keyword": "#30AFFF",
    "operator": "#7DDFFF",
    "string": "#C4F7CA",
    "number": "#FFD166",
    "regexp": "#F7D774",
    "decorator": "#30AFFF",
    "*.declaration": {
      "fontStyle": "bold"
    },
    "*.readonly": {
      "fontStyle": "italic"
    }
  }
}