    "sideBar.background": "#0E2026",
    "sideBar.foreground": "#CDEBE5",
    "sideBar.border": "#17343B",
    "sideBarTitle.foreground": "#92EEFF",
    "sideBarSectionHeader.background": "#122A31",
    "sideBarSectionHeader.foreground": "#C4F7CA",
    "editorGroupHeader.tabsBackground": "#0B1C22",
    "editorGroupHeader.tabsBorder": "#17343B",
    "tab.activeBackground": "#10272D",
    "tab.activeForeground": "#F1FFFC",
    "tab.activeBorderTop": "#30AFFF",
    "tab.inactiveBackground": "#0B1C22",
    "tab.inactiveForeground": "#7FA39D",
    "tab.hoverBackground": "#122A31",
    "editor.background": "#10272D",
    "editor.foreground": "#D9F7F1",
    "editorLineNumber.foreground": "#496B66",
