    "editorIndentGuide.background1": "#1C3A40",
    "editorIndentGuide.activeBackground1": "#30AFFF",
    "editorWhitespace.foreground": "#24454A",
    "editorBracketMatch.background": "#244D4566",
    "editorBracketMatch.border": "#92EEFF",
    "editorGutter.addedBackground": "#53C987",
    "editorGutter.modifiedBackground": "#30AFFF",
    "editorGutter.deletedBackground": "#FF6B7A",
    "editorError.foreground": "#FF6B7A",
    "editorWarning.foreground": "#FFD166",
    "editorInfo.foreground": "#92EEFF",
    "editorHint.foreground": "#C4F7CA",
    "editorWidget.background": "#112A31",
    "editorWidget.foreground": "#E7F7F4",
    "editorWidget.border": "#2A5863",
    "editorSuggestWidget.selectedBackground": "#174B5D",
    "peekView.border": "#30AFFF",
