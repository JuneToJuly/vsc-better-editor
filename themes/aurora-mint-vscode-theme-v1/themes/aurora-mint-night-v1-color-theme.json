    "terminal.foreground": "#D9F7F1",
    "terminalCursor.foreground": "#D8FFC5",
    "terminal.ansiBlue": "#30AFFF",
    "terminal.ansiBrightBlue": "#92EEFF",
    "terminal.ansiGreen": "#63D895",
    "terminal.ansiBrightGreen": "#C4F7CA",
    "terminal.ansiCyan": "#54D3DF",
    "terminal.ansiBrightCyan": "#A9F5FF",
    "terminal.ansiYellow": "#FFD166",
    "terminal.ansiBrightYellow": "#FFE59A",
    "terminal.ansiRed": "#FF6B7A",
    "terminal.ansiBrightRed": "#FF9DA8",
    "terminal.ansiMagenta": "#C49BFF",
    "terminal.ansiBrightMagenta": "#DCC4FF",
