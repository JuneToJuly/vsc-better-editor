  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#767183",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#8A79FF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#C2BBFF"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#E4E1FF"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#A7D6C4"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#D9C78B"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#DCE6F0"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#B8AFFF",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#9EC9E6"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#7F6BF5"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#B1A6E7"
      }
    },
    {
      "scope": [
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#FEFFFE",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "meta.annotation",
        "storage.type.annotation",
        "entity.name.function.annotation"
      ],
      "settings": {
        "foreground": "#A991FF"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "operator"
      ],
      "settings": {
        "foreground": "#B7B3C4"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#8F899B"
      }
    },
    {
      "scope": [
        "string.regexp",
        "constant.regexp"
      ],
      "settings": {
        "foreground": "#AFA3FF"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#F8899D",
        "fontStyle": "underline"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#A9A1C2",
    "type": "#C2BBFF",
    "class": {
      "foreground": "#CEC8FF",
      "bold": true
    },
    "enum": "#AE9BFF",
    "interface": "#9F96D9",
    "struct": "#B3ACE2",
    "typeParameter": "#B8AFFF",
    "parameter": {
      "foreground": "#B8AFFF",
      "italic": true
    },
    "variable": "#DCE6F0",
    "property": "#9EC9E6",
    "enumMember": {
      "foreground": "#FEFFFE",
      "bold": true
    },
    "function": "#E4E1FF",
    "method": "#D7D2FF",
    "macro": "#8A79FF",
    "label": "#B0A8D0",
    "comment": {
      "foreground": "#767183",
      "italic": true
    },
    "string": "#A7D6C4",
    "number": "#D9C78B",
    "regexp": "#AFA3FF",
    "operator": "#B7B3C4",
    "decorator": "#A991FF",
    "keyword": {
      "foreground": "#8A79FF",
      "bold": true
    },
    "variable.readonly": "#E4E1FF",
    "property.readonly": "#C6C0E2",
    "method.declaration": {
      "foreground": "#C8C1FF",
      "bold": true
    },
    "function.declaration": {
      "foreground": "#C8C1FF",
      "bold": true
    },
    "class.declaration": {
      "foreground": "#CEC8FF",
      "bold": true
    }
  }
}
