    "terminal.ansiBrightRed": "#FF9AAF",
    "terminal.ansiYellow": "#E8D982",
    "terminal.ansiBrightYellow": "#F3E79E",
    "terminal.ansiGreen": "#5EC783",
    "terminal.ansiBrightGreen": "#8FE1A7",
    "terminal.ansiCyan": "#68C1D0",
    "terminal.ansiBrightCyan": "#96E5F0"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A096A5",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#AE55E8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#D77BE4"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#C768EA"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#E8D982"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null"
      ],
      "settings": {
        "foreground": "#F0DF8D"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#EAE4ED"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#C9B5CF",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#C88CD2"
      }
    },
    {
      "scope": [
        "constant.other",
        "variable.other.constant",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#E8D982"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.package",
        "support.namespace"
      ],
      "settings": {
        "foreground": "#D77BE4"
      }
    },
    {
      "scope": [
        "meta.annotation",
        "storage.type.annotation",
        "entity.name.type.annotation"
      ],
      "settings": {
        "foreground": "#BE73F0"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FF7088",
        "fontStyle": "bold underline"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#EEE8F1"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#EAE4ED",
    "variable.readonly": "#E8D982",
    "parameter": "#C9B5CF",
    "property": "#C88CD2",
    "enumMember": "#F0DF8D",
    "function": "#C768EA",
    "method": "#C768EA",
    "class": "#D77BE4",
    "interface": "#D77BE4",
    "enum": "#D77BE4",
    "type": "#D77BE4",
    "typeParameter": "#BE73F0",
    "namespace": "#D77BE4",
    "keyword": "#AE55E8",
    "operator": "#C88CD2",
    "string": "#E8D982",
    "number": "#F0DF8D",
    "regexp": "#F3E79E",
    "decorator": "#BE73F0",
    "*.declaration": {
      "fontStyle": "bold"
    },
    "*.readonly": {
      "fontStyle": "italic"
    }
  }
}