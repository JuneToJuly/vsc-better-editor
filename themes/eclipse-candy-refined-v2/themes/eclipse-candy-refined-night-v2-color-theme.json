    "statusBar.debuggingBackground": "#E8D982",
    "statusBar.debuggingForeground": "#000000",
    "statusBar.noFolderBackground": "#3B2B46",
    "titleBar.activeBackground": "#000000",
    "titleBar.activeForeground": "#EEE8F1",
    "titleBar.inactiveBackground": "#141217",
    "titleBar.inactiveForeground": "#777078",
    "breadcrumb.background": "#18151C",
    "breadcrumb.foreground": "#817984",
    "breadcrumb.focusForeground": "#D77BE4",
