    "decorator": "#FF82DC",
    "label": "#00E5E8",
    "comment": "#9A83A1",
    "string": "#61D5CF",
    "number": "#FF9FDF",
    "regexp": "#F0F600",
    "operator": "#00E5E8",
    "keyword": "#FF3CC7"
  }
}
