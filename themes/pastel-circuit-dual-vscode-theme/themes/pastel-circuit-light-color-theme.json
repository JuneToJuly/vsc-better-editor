  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#718087",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.documentation",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#6F7D84",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.other.using"
      ],
      "settings": {
        "foreground": "#667A16",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.arithmetic"
      ],
      "settings": {
        "foreground": "#48565D"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#9150A8",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.interface",
        "entity.name.trait",
        "storage.type.interface"
      ],
      "settings": {
        "foreground": "#A45BBE"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#19788B"
      }
    },
    {
      "scope": [
        "entity.name.method",
        "meta.method-call",
        "support.function.any-method"
      ],
      "settings": {
        "foreground": "#287F90"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#287D59"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.function.parameters"
      ],
      "settings": {
        "foreground": "#397A60",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.other.property",
