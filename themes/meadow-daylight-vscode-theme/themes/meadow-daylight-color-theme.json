  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#7D9083", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#7A6B35", "fontStyle": "bold" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type", "entity.name.namespace"], "settings": { "foreground": "#765B86" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"], "settings": { "foreground": "#3F7787" } },
    { "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#537D46" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#A4634F" } },
    { "scope": ["variable", "meta.definition.variable.name", "variable.other.readwrite"], "settings": { "foreground": "#355B70" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#8A5D70", "fontStyle": "italic" } },
    { "scope": ["variable.other.property", "support.variable.property", "meta.object-literal.key"], "settings": { "foreground": "#4F7668" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#668C52" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#8A6B3D" } },
    { "scope": ["keyword.operator", "punctuation", "meta.brace", "meta.delimiter"], "settings": { "foreground": "#617D82" } },
    { "scope": ["entity.name.decorator", "meta.annotation", "punctuation.definition.annotation"], "settings": { "foreground": "#8B678E" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#FFFFFF", "background": "#B85C55" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#4E7568", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#5E7040", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#7D6684", "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code.block"], "settings": { "foreground": "#3F7787" } }
  ],
  "semanticTokenColors": {
    "namespace": "#765B86",
    "type": "#765B86",
    "class": { "foreground": "#765B86" },
    "enum": "#765B86",
    "interface": "#6C658A",
    "struct": "#765B86",
    "typeParameter": "#8A668B",
    "parameter": { "foreground": "#8A5D70", "italic": true },
    "variable": "#355B70",
    "property": "#4F7668",
    "enumMember": "#A4634F",
    "function": "#3F7787",
    "method": "#3F7787",
    "macro": "#8B678E",
    "keyword": { "foreground": "#7A6B35", "bold": true },
    "modifier": "#7A6B35",
    "comment": { "foreground": "#7D9083", "italic": true },
    "string": "#537D46",
    "number": "#A4634F",
    "regexp": "#4D8878",
    "operator": "#617D82",
    "decorator": "#8B678E",
    "*.declaration": { "bold": true },
    "*.readonly": "#8F6D3D",
    "*.static": "#6B668B",
    "*.deprecated": { "strikethrough": true }
  }
}
