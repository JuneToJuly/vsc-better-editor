  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#778186",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Control flow",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.return",
        "keyword.control.exception"
      ],
      "settings": {
        "foreground": "#E3B465"
      }
    },
    {
      "name": "Declarations and modifiers",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.declaration",
        "keyword.operator.new",
        "keyword.package",
        "keyword.import"
      ],
      "settings": {
        "foreground": "#D99A5A"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.type.class",
        "entity.name.type.interface",
        "support.type",
        "support.class",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#D7EA79"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function",
        "meta.method-call",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#CDD2CF"
      }
    },
    {
      "name": "Annotations",
      "scope": [
        "meta.annotation",
        "punctuation.definition.annotation",
        "entity.name.function.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#A56AA0"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#CFE85F"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "variable.other.constant",
        "constant.other"
      ],
      "settings": {
        "foreground": "#D3D8D4"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "identifier",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#F1F2EE"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "meta.parameters"
      ],
      "settings": {
        "foreground": "#C4C9C6"
      }
    },
    {
      "name": "Properties and fields",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#B89AB3"
      }
    },
    {
      "name": "Packages and namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.package",
        "support.type.namespace"
      ],
      "settings": {
        "foreground": "#AAB3B5"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "punctuation.separator",
        "punctuation.accessor",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#A7B0B2"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#7B355D"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#AAB3B5",
    "type": "#D7EA79",
    "class": "#D7EA79",
    "class.declaration": "#D7EA79",
    "enum": "#D7EA79",
    "interface": "#D7EA79",
    "struct": "#D7EA79",
    "typeParameter": "#C8D995",
    "parameter": "#C4C9C6",
    "variable": "#F1F2EE",
    "variable.readonly": "#D3D8D4",
    "variable.static": "#D3D8D4",
    "property": "#B89AB3",
    "property.readonly": "#C6A8C1",
    "property.static": "#C6A8C1",
    "enumMember": "#D3D8D4",
    "function": "#CDD2CF",
    "function.declaration": "#CDD2CF",
    "method": "#CDD2CF",
    "method.declaration": "#CDD2CF",
    "function.defaultLibrary": "#E0E4E1",
    "method.defaultLibrary": "#E0E4E1",
    "decorator": "#A56AA0",
    "annotation": "#A56AA0",
    "macro": "#D99A5A",
    "label": "#DCF763",
    "keyword": "#D99A5A",
    "modifier": "#D99A5A",
    "operator": "#A7B0B2",
    "comment": {
      "foreground": "#778186",
      "italic": true
    },
    "string": "#CFE85F",
    "number": "#D3D8D4",
    "regexp": "#AFCB78",
    "boolean": "#D3D8D4",
    "null": "#D3D8D4",
    "event": "#A56AA0"
  }
}
